FROM python:3.12.14-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-parser.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements-parser.lock && \
    useradd --uid 10001 --create-home parser && mkdir /ipc && chown 10001:10001 /ipc
COPY --chown=10001:10001 rag/__init__.py rag/parser_app.py rag/pdf_worker.py /app/rag/
USER 10001:10001
CMD ["uvicorn", "rag.parser_app:app", "--uds", "/ipc/parser.sock", "--no-access-log"]
