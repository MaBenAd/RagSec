# GroqCloud
GROQ_API_KEY=your_groqcloud_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# JWT
JWT_SECRET_KEY=change_me_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (Cache)
# For local development (bash ./dev.sh), use 127.0.0.1
# For Docker production, use 'redis'
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
ENABLE_CACHE=true

# Initial admin seed (only used if admin account does not exist)
ADMIN_PASSWORD=change_me_with_a_strong_admin_password
DEMO_STUDENT_EMAIL=kossi_richard.allado@usms.ac.ma
DEMO_STUDENT_PASSWORD=change_me_with_a_strong_student_password
DEMO_STUDENT_CLASS=IACS_2025-2026_S4

# CORS (frontend Next.js local)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Performance
CHAT_TIMEOUT_SECONDS=90
ENABLE_RAG_FALLBACK=false
RAG_EMBEDDING_BACKEND=hash
ENABLE_EMOTION_LLM=false
ENABLE_EDT_LLM=false
ENABLE_TITLE_LLM=false
APP_TIMEZONE=Africa/Casablanca

# Local vectorstore path (relative for local dev, or absolute for Docker)
# When running via Docker, this is usually ignored if QDRANT_URL is set.
VECTORSTORE_PATH=backend/data/vectorstore_qdrant

# Qdrant server URL
# Use 127.0.0.1 for local dev (dev.sh) / 'qdrant' for Docker
QDRANT_URL=http://127.0.0.1:6333

# Database
# Use 127.0.0.1 for local dev (dev.sh) / 'postgres' for Docker
DATABASE_URL=postgresql://ensa_user:ensa_pass@127.0.0.1:5432/ensa_db
DOCKER_DATABASE_URL=postgresql://ensa_user:ensa_pass@postgres:5432/ensa_db
POSTGRES_USER=ensa_user
POSTGRES_PASSWORD=ensa_pass
POSTGRES_DB=ensa_db
